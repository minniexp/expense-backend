# Backend environment — NAMES ONLY. Never commit real values.
# Copy to .env for local development; set the same keys in the Vercel project settings.

# --- Core ---------------------------------------------------------------------------------
PORT=
MONGODB_URI=
NODE_ENV=

# --- Session signing ----------------------------------------------------------------------
# Rotating this invalidates every issued session token.
JWT_SECRET=
# Optional. Session token lifetime, e.g. "7d". Defaults to 7d.
SESSION_TTL=

# --- Server-to-server auth ------------------------------------------------------------------
# REQUIRED. Shared with the Next.js app; must be identical on both sides.
# Minimum 32 characters — the middleware refuses to run below that.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# This gates /api/users/* and /api/teller/*, so it must never reach a browser. On the Next.js
# side it must NOT be prefixed NEXT_PUBLIC_.
INTERNAL_API_SECRET=

# --- Google sign-in verification -------------------------------------------------------------
# REQUIRED. The expected `aud` claim on Google ID tokens. Without it the backend refuses to
# verify sign-ins at all, because an unset audience check would accept a genuine Google token
# minted for any other application.
GOOGLE_CLIENT_ID=

# Optional hard allowlist, comma-separated. When set it overrides the isApproved database flag,
# so a database change alone cannot grant access to this deployment.
TELLER_ALLOWED_EMAILS=

# --- CORS ---------------------------------------------------------------------------------
# Comma-separated origins permitted to call the API from a browser. Falls back to the
# hard-coded production list in server.js when unset.
ALLOWED_ORIGINS=

# --- Teller ---------------------------------------------------------------------------------
TELLER_APPLICATION_ID=
# REQUIRED. One of: sandbox | development | production
#   sandbox     - fake test data, free
#   development - REAL bank data, free, limited number of enrollments
#   production  - REAL bank data, requires payment setup on the Teller application
# Teller Connect uses this to decide which environment to look the enrollment up in, and an
# enrollment exists in exactly one of them. Point it at the wrong one and Connect reports
# "an enrollment with that id could not be found" — which reads like a bad id and is not.
# Real bank data on an application without payment setup means "development".
#
# Note this only configures the Connect widget. Reading transactions uses the access token and
# mTLS certificate and is unaffected by this value.
TELLER_ENV=
TELLER_ACCESS_TOKEN=
TELLER_ENROLLMENT_ID=

# mTLS material, base64-encoded PEM. Required in any environment without the gitignored certs/
# directory — which includes every serverless deployment. Produce them with:
#   base64 -i certs/certificate.pem | tr -d '\n'
#   base64 -i certs/private_key.pem | tr -d '\n'
TELLER_CERT_B64=
TELLER_KEY_B64=

# Optional. Teller fetches permitted per user per 5 minutes. Defaults to 10.
TELLER_RATE_LIMIT_MAX=

# --- Phone ingest ----------------------------------------------------------------------------
# REQUIRED to accept transactions posted from outside the web UI (an iOS Shortcut).
# Minimum 32 characters; the middleware refuses to run below that and fails closed when unset.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Guards a CREATE-ONLY route: a holder can add ledger rows, not read bank data or delete
# anything. Kept separate from JWT_SECRET and INTERNAL_API_SECRET so losing the phone means
# rotating one value, without logging anyone out or breaking the site.
INGEST_TOKEN=

# Optional. Ingest requests permitted per hour. Defaults to 120.
INGEST_RATE_LIMIT_MAX=

# Card last-four -> payment method, comma-separated. A bank alert email names the card only by its
# last four digits, so this is what turns "8923" into an account the ledger recognises.
#
# Each name must be spelled exactly as it appears in PAYMENT_METHODS (frontend utils/constants.js).
# That string decides the row's sign, its points, and whether the /my dropdowns can edit it. Alerts
# are the only source of transactions now that the Teller feed is retired, so a wrong name is never
# corrected by anything downstream. An unlisted card is REJECTED with a 400 rather than filed as Cash.
#
#   CARD_LAST4_MAP=8837:Chase College,3143:Freedom,8923:Freedom Unlimited,1731:Freedom Flex,0419:Sapphire Reserve,1301:Amazon Visa
#
# Note "Sapphire Reserve", not "Sapphire": calculatePoints() rewards that exact string for lyft,
# flight and dining, and the /my dropdown only offers the names in PAYMENT_METHODS. A leading zero
# is fine — keys are compared as text, so 0419 stays 0419.
CARD_LAST4_MAP=

# --- Account and record IDs ------------------------------------------------------------------
PENDING_TRANSACTIONS_ID=
MONGODB_USERID=
MONGODB_DADID=
MONGODB_MOMID=

AMAZON_VISA_ID=
CHASE_COLLEGE_ID=
FREEDOM_FLEX_ID=
SAPPHIRE_RESERVE_ID=
FREEDOM_ID=
FREEDOM_UNLIMITED_ID=

# Monthly return document IDs, per year: <YEAR>_<MON>_RETURNID
# e.g. 2026_JAN_RETURNID=
