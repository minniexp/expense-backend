# Backend environment — NAMES ONLY. Never commit real values.
# Copy to .env for local development; set the same keys in the Vercel project settings.

# --- Core ---------------------------------------------------------------------------------
PORT=
MONGODB_URI=
NODE_ENV=

# --- Session signing ----------------------------------------------------------------------
# Rotating this invalidates every issued session token.
JWT_SECRET=
# Optional. Session token lifetime, e.g. "7d". Defaults to 7d.
SESSION_TTL=

# --- Server-to-server auth ------------------------------------------------------------------
# REQUIRED. Shared with the Next.js app; must be identical on both sides.
# Minimum 32 characters — the middleware refuses to run below that.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# This gates /api/users/* and /api/teller/*, so it must never reach a browser. On the Next.js
# side it must NOT be prefixed NEXT_PUBLIC_.
INTERNAL_API_SECRET=

# --- Google sign-in verification -------------------------------------------------------------
# REQUIRED. The expected `aud` claim on Google ID tokens. Without it the backend refuses to
# verify sign-ins at all, because an unset audience check would accept a genuine Google token
# minted for any other application.
GOOGLE_CLIENT_ID=

# Optional hard allowlist, comma-separated. When set it overrides the isApproved database flag,
# so a database change alone cannot grant access to this deployment.
TELLER_ALLOWED_EMAILS=

# --- CORS ---------------------------------------------------------------------------------
# Comma-separated origins permitted to call the API from a browser. Falls back to the
# hard-coded production list in server.js when unset.
ALLOWED_ORIGINS=

# --- Teller ---------------------------------------------------------------------------------
TELLER_APPLICATION_ID=
TELLER_ENV=
TELLER_ACCESS_TOKEN=
TELLER_ENROLLMENT_ID=

# mTLS material, base64-encoded PEM. Required in any environment without the gitignored certs/
# directory — which includes every serverless deployment. Produce them with:
#   base64 -i certs/certificate.pem | tr -d '\n'
#   base64 -i certs/private_key.pem | tr -d '\n'
TELLER_CERT_B64=
TELLER_KEY_B64=

# Optional. Teller fetches permitted per user per 5 minutes. Defaults to 10.
TELLER_RATE_LIMIT_MAX=

# --- Account and record IDs ------------------------------------------------------------------
PENDING_TRANSACTIONS_ID=
MONGODB_USERID=
MONGODB_DADID=
MONGODB_MOMID=

AMAZON_VISA_ID=
CHASE_COLLEGE_ID=
FREEDOM_FLEX_ID=
SAPPHIRE_RESERVE_ID=
FREEDOM_ID=
FREEDOM_UNLIMITED_ID=

# Monthly return document IDs, per year: <YEAR>_<MON>_RETURNID
# e.g. 2026_JAN_RETURNID=
